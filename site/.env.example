# Copy this file to .env for local builds. Never commit .env.
# In production these are set in Netlify → Site configuration → Environment variables.

# Google Places API (New) key, restricted to "Places API (New)" only.
GOOGLE_PLACES_API_KEY=

# The firm's Google Place ID (from Google's Place ID Finder), e.g. ChIJ...
GOOGLE_PLACE_ID=
