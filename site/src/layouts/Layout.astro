---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Fingerhut Law — New York and New Jersey Employment Lawyer',
  description = 'A focused employment law practice in New York and New Jersey. Over $30 million recovered for workers in discrimination, harassment, retaliation, and wrongful termination cases.',
  image = '/images/steven-fingerhut.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).toString();

// Site-wide config pulled from homepage.md (phone, fee note, etc.) so values
// stay editable in one place.
const homepage = await getEntry('pages', 'homepage');
const site = homepage!.data;

// JSON-LD structured data — tells Google this is a law firm with these
// service areas, hours, address, and practice focus. Drives local-pack
// eligibility for "NYC employment lawyer" style queries.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Fingerhut Law',
  alternateName: 'The Fingerhut Law Group, PLLC',
  url: 'https://fingerhutlawgroup.com',
  logo: 'https://fingerhutlawgroup.com/brand/wordmark-navy.svg',
  image: 'https://fingerhutlawgroup.com/images/steven-fingerhut.jpg',
  telephone: '+1-212-680-4040',
  email: 'steven@fingerhutlawgroup.com',
  priceRange: 'Contingency fee where appropriate — no fee unless we recover',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '469 7th Avenue, 12th Floor',
    addressLocality: 'New York',
    addressRegion: 'NY',
    postalCode: '10018',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'State', name: 'New York' },
    { '@type': 'State', name: 'New Jersey' },
  ],
  founder: {
    '@type': 'Person',
    name: 'Steven Fingerhut',
    jobTitle: 'Attorney',
    image: 'https://fingerhutlawgroup.com/images/steven-fingerhut.jpg',
  },
  knowsAbout: [
    'Employment Discrimination',
    'Workplace Sexual Harassment',
    'Wrongful Termination',
    'Workplace Retaliation',
    'Wage and Hour Violations',
    'FMLA Retaliation',
    'Whistleblower Protection',
    'Severance Negotiation',
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fingerhut Law" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=Inter:wght@300;400;500;600;700&display=swap"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-r86CYaVsK2ODZfY5lMOLE.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="min-h-screen bg-fl-bg text-fl-ink font-sans antialiased">
    <header class="border-b border-slate-200">
      <nav class="mx-auto max-w-6xl px-6 py-5 flex items-center justify-between">
        <a href="/" class="inline-flex items-center" aria-label="Fingerhut Law — home">
          <img src="/brand/wordmark-navy.svg" alt="Fingerhut Law" class="h-7 md:h-9 w-auto" />
        </a>
        <ul class="hidden md:flex items-center gap-8 text-sm font-semibold text-fl-ink">
          <li><a href="/about" class="hover:text-fl-accent transition-colors">About</a></li>
          <li><a href="/practice-areas" class="hover:text-fl-accent transition-colors">Practice Areas</a></li>
          <li><a href="/results" class="hover:text-fl-accent transition-colors">Results</a></li>
          <li><a href="/faq" class="hover:text-fl-accent transition-colors">FAQ</a></li>
          <li><a href="/press" class="hover:text-fl-accent transition-colors">Press</a></li>
          <li><a href="/contact" class="hover:text-fl-accent transition-colors">Contact</a></li>
        </ul>
        <a href="tel:+12126804040" class="hidden md:inline text-sm font-semibold text-fl-accent hover:text-fl-accent-2 transition-colors">
          (212) 680-4040
        </a>
        <button
          id="fl-mobile-menu-button"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2 -mr-2 text-fl-ink"
          aria-label="Open menu"
          aria-controls="fl-mobile-menu"
          aria-expanded="false"
        >
          <svg id="fl-mobile-menu-icon-open" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="fl-mobile-menu-icon-close" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </nav>
      <div id="fl-mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white">
        <ul class="mx-auto max-w-6xl px-6 py-4 flex flex-col divide-y divide-slate-100 text-base font-semibold text-fl-ink">
          <li><a href="/about" class="block py-3 hover:text-fl-accent transition-colors">About</a></li>
          <li><a href="/practice-areas" class="block py-3 hover:text-fl-accent transition-colors">Practice Areas</a></li>
          <li><a href="/results" class="block py-3 hover:text-fl-accent transition-colors">Results</a></li>
          <li><a href="/faq" class="block py-3 hover:text-fl-accent transition-colors">FAQ</a></li>
          <li><a href="/press" class="block py-3 hover:text-fl-accent transition-colors">Press</a></li>
          <li><a href="/contact" class="block py-3 hover:text-fl-accent transition-colors">Contact</a></li>
          <li><a href="tel:+12126804040" class="block py-3 text-fl-accent">Call (212) 680-4040</a></li>
        </ul>
      </div>
    </header>

    <script>
      const btn = document.getElementById('fl-mobile-menu-button');
      const panel = document.getElementById('fl-mobile-menu');
      const iconOpen = document.getElementById('fl-mobile-menu-icon-open');
      const iconClose = document.getElementById('fl-mobile-menu-icon-close');
      btn?.addEventListener('click', () => {
        const open = panel?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="mt-24 border-t border-slate-200 bg-slate-50">
      <div class="mx-auto max-w-6xl px-6 py-12 text-sm text-fl-ink-soft">
        <div class="mb-5 flex items-center gap-3 flex-wrap">
          <img src="/brand/wordmark-navy.svg" alt="Fingerhut Law" class="h-6 w-auto" />
          <span class="font-serif text-base text-fl-ink-soft">· New York and New Jersey Employment Law</span>
        </div>
        <p class="mb-4 italic">
          Fingerhut Law is a DBA of The Fingerhut Law Group, PLLC,
          a New York professional limited liability company.
        </p>
        <p class="mb-4">
          469 7th Avenue, 12th Floor, New York, NY 10018 ·
          <a href="tel:+12126804040" class="text-fl-accent hover:underline">(212) 680-4040</a> ·
          <a href="mailto:steven@fingerhutlawgroup.com" class="text-fl-accent hover:underline">steven@fingerhutlawgroup.com</a>
        </p>
        <p class="mb-4">
          Monday through Friday, 9:00 am – 6:00 pm ET. After-hours consultations by appointment.
        </p>
        {site.feeNote && (
          <p class="mb-4 italic">{site.feeNote}</p>
        )}
        <p class="mb-4 text-xs">
          Admitted: New York · New Jersey · S.D.N.Y. · E.D.N.Y. · N.D.N.Y. · W.D.N.Y. · D.N.J. · Second Circuit Court of Appeals
        </p>
        <p class="text-xs">
          <em>Attorney Advertising. Prior results do not guarantee a similar outcome.
          The information on this website is for general informational purposes only
          and is not legal advice. Contacting the firm does not create an
          attorney-client relationship.</em>
        </p>
        <p class="mt-6 text-xs">
          <a href="/privacy" class="hover:text-fl-accent">Privacy Policy</a>
          <span class="text-slate-400 mx-2">·</span>
          <a href="/terms" class="hover:text-fl-accent">Legal Notices</a>
        </p>
        <p class="mt-3 text-xs">© 2026 The Fingerhut Law Group, PLLC. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>
