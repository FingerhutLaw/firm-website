---
import '../styles/global.css';
import { getEntry } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Friedman & Fingerhut — New York and New Jersey Employment Lawyers',
  description = 'A focused employment law practice in New York and New Jersey. $60 million-plus recovered for workers in discrimination, harassment, retaliation, and wrongful termination cases.',
  image = '/images/steven-and-josh.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site).toString();

// Site-wide config pulled from homepage.md (phone, fee note, etc.) so values
// stay editable in one place.
const homepage = await getEntry('pages', 'homepage');
const site = homepage!.data;

// JSON-LD structured data — tells Google this is a law firm with these
// service areas, hours, address, and practice focus. Drives local-pack
// eligibility for "NYC employment lawyer" style queries.
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: 'Friedman & Fingerhut, PLLC',
  url: 'https://friedmanfingerhut.com',
  image: 'https://friedmanfingerhut.com/images/steven-and-josh.jpg',
  telephone: '+1-212-680-4040',
  email: 'intake@friedmanfingerhut.com',
  priceRange: 'Contingency fee where appropriate — no fee unless we recover',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '469 7th Avenue, 12th Floor',
    addressLocality: 'New York',
    addressRegion: 'NY',
    postalCode: '10018',
    addressCountry: 'US',
  },
  areaServed: [
    { '@type': 'State', name: 'New York' },
    { '@type': 'State', name: 'New Jersey' },
  ],
  founders: [
    {
      '@type': 'Person',
      name: 'Steven Fingerhut',
      jobTitle: 'Attorney',
      image: 'https://friedmanfingerhut.com/images/steven-fingerhut.jpg',
    },
    {
      '@type': 'Person',
      name: 'Joshua Friedman',
      jobTitle: 'Attorney',
      image: 'https://friedmanfingerhut.com/images/josh-friedman.jpg',
    },
  ],
  knowsAbout: [
    'Employment Discrimination',
    'Workplace Sexual Harassment',
    'Wrongful Termination',
    'Workplace Retaliation',
    'Wage and Hour Violations',
    'FMLA Retaliation',
    'Whistleblower Protection',
    'Severance Negotiation',
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '18:00',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Friedman & Fingerhut" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=GFS+Didot&family=Inter:wght@300;400;500;600;700&display=swap"
    />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-HW6BERnq6ae1XhaDn2W17.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>
  </head>
  <body class="min-h-screen bg-fl-bg text-fl-ink font-sans antialiased overflow-x-hidden">
    <header class="border-b border-black/20 bg-fl-ink-navy">
      <nav class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between gap-4">
        <a href="/" class="inline-flex items-center gap-3" aria-label="Friedman & Fingerhut — home">
          <!-- Double-line brass monogram on midnight: brass rule holds,
               F|F letters shift to white so they read on the dark bar. -->
          <span class="relative inline-flex items-center justify-center h-9 w-[32px] border border-fl-brass-rule shrink-0" aria-hidden="true">
            <span class="absolute inset-[3px] border border-fl-brass-rule/80"></span>
            <span class="relative font-didot text-white text-[14px] leading-none inline-flex items-center">
              <span class="inline-block -scale-x-100">F</span><span class="inline-block">F</span>
            </span>
          </span>
          <span class="hidden sm:inline-block font-didot uppercase tracking-[0.14em] text-[15px] md:text-[17px] text-white leading-none pt-0.5">
            Friedman &amp; Fingerhut
          </span>
        </a>
        <ul class="hidden md:flex items-center gap-7 text-xs uppercase tracking-[0.1em] font-semibold text-white/80">
          <li class="relative group">
            <button type="button" class="inline-flex items-center gap-1 uppercase tracking-[0.1em] font-semibold text-white/80 hover:text-fl-clay-peach transition-colors focus:outline-none" aria-haspopup="true">
              About
              <svg class="h-2.5 w-2.5" viewBox="0 0 10 6" fill="currentColor" aria-hidden="true">
                <path d="M0 0l5 6 5-6z" />
              </svg>
            </button>
            <!-- Dropdown panel: a hover buffer (the top-full pt-2) keeps it open
                 while the pointer crosses the gap from the button into the panel. -->
            <div class="hidden group-hover:block group-focus-within:block absolute left-1/2 -translate-x-1/2 top-full pt-2 z-20">
              <ul class="min-w-[13rem] bg-fl-bg border border-fl-brass-rule/40 shadow-lg py-2 normal-case tracking-normal text-sm font-medium text-fl-ink">
                <li><a href="/attorneys" class="block px-5 py-2.5 hover:bg-fl-bg-tint hover:text-fl-clay transition-colors">Attorneys</a></li>
                <li><a href="/how-we-practice" class="block px-5 py-2.5 hover:bg-fl-bg-tint hover:text-fl-clay transition-colors">How We Practice</a></li>
              </ul>
            </div>
          </li>
          <li><a href="/practice-areas" class="hover:text-fl-clay-peach transition-colors">Practice Areas</a></li>
          <li><a href="/results" class="hover:text-fl-clay-peach transition-colors">Results</a></li>
          <li><a href="/faq" class="hover:text-fl-clay-peach transition-colors">FAQ</a></li>
          <li><a href="/blog" class="hover:text-fl-clay-peach transition-colors">Blog</a></li>
          <li><a href="/press" class="hover:text-fl-clay-peach transition-colors">Press</a></li>
          <li><a href="/contact" class="hover:text-fl-clay-peach transition-colors">Contact</a></li>
        </ul>
        <!-- Terracotta pill around the phone — the one tap element in the nav.
             Clay is reserved for actions; nothing else in the header is this color. -->
        <a href="tel:+12126804040" class="hidden md:inline-flex items-center bg-fl-clay text-white px-4 py-2 rounded-full text-sm font-semibold hover:bg-fl-clay-ink transition-colors whitespace-nowrap">
          (212) 680-4040
        </a>
        <button
          id="fl-mobile-menu-button"
          type="button"
          class="md:hidden inline-flex items-center justify-center p-2 -mr-2 text-white"
          aria-label="Open menu"
          aria-controls="fl-mobile-menu"
          aria-expanded="false"
        >
          <svg id="fl-mobile-menu-icon-open" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" />
          </svg>
          <svg id="fl-mobile-menu-icon-close" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18" />
          </svg>
        </button>
      </nav>
      <div id="fl-mobile-menu" class="hidden md:hidden border-t border-fl-bg-tint bg-fl-bg">
        <ul class="mx-auto max-w-6xl px-6 py-4 flex flex-col divide-y divide-slate-100 text-base font-semibold text-fl-ink">
          <li class="py-3">
            <div class="mb-1 text-fl-ink-soft uppercase tracking-[0.1em] text-xs font-semibold">About</div>
            <ul class="pl-3 space-y-2">
              <li><a href="/attorneys" class="block py-1 hover:text-fl-clay transition-colors">Attorneys</a></li>
              <li><a href="/how-we-practice" class="block py-1 hover:text-fl-clay transition-colors">How We Practice</a></li>
            </ul>
          </li>
          <li><a href="/practice-areas" class="block py-3 hover:text-fl-clay transition-colors">Practice Areas</a></li>
          <li><a href="/results" class="block py-3 hover:text-fl-clay transition-colors">Results</a></li>
          <li><a href="/faq" class="block py-3 hover:text-fl-clay transition-colors">FAQ</a></li>
          <li><a href="/blog" class="block py-3 hover:text-fl-clay transition-colors">Blog</a></li>
          <li><a href="/press" class="block py-3 hover:text-fl-clay transition-colors">Press</a></li>
          <li><a href="/contact" class="block py-3 hover:text-fl-clay transition-colors">Contact</a></li>
          <li><a href="tel:+12126804040" class="block py-3 text-fl-clay font-semibold">Call (212) 680-4040</a></li>
        </ul>
      </div>
    </header>

    <script>
      const btn = document.getElementById('fl-mobile-menu-button');
      const panel = document.getElementById('fl-mobile-menu');
      const iconOpen = document.getElementById('fl-mobile-menu-icon-open');
      const iconClose = document.getElementById('fl-mobile-menu-icon-close');
      btn?.addEventListener('click', () => {
        const open = panel?.classList.toggle('hidden') === false;
        btn.setAttribute('aria-expanded', String(open));
        btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        iconOpen?.classList.toggle('hidden', open);
        iconClose?.classList.toggle('hidden', !open);
      });
    </script>

    <main>
      <slot />
    </main>

    <footer class="mt-24 bg-fl-accent text-white">
      <div class="mx-auto max-w-6xl px-6 pt-16 pb-8">
        <div class="grid grid-cols-1 md:grid-cols-[1.3fr_1fr_1fr] gap-10 items-start">
          <div>
            <div class="flex items-center gap-3 mb-3">
              <!-- Double-line brass monogram, open center + mirrored F|F
                   bookend wordmark in white for the navy footer band. -->
              <span class="relative inline-flex items-center justify-center h-11 w-[38px] border border-fl-brass-rule shrink-0" aria-hidden="true">
                <span class="absolute inset-[3px] border border-fl-brass-rule/70"></span>
                <span class="relative font-didot text-white text-[17px] leading-none inline-flex items-center">
                  <span class="inline-block -scale-x-100">F</span><span class="inline-block">F</span>
                </span>
              </span>
              <span class="font-didot uppercase tracking-[0.14em] text-[17px] text-white leading-none pt-1">
                Friedman &amp; Fingerhut
              </span>
            </div>
            <p class="font-serif italic text-white/80 text-base leading-relaxed max-w-md">
              A focused employment law practice representing workers in New York and New Jersey.
            </p>
          </div>
          <div>
            <h4 class="text-[10.5px] uppercase tracking-[0.22em] font-semibold text-fl-brass-rule mb-3">Office</h4>
            <p class="text-sm text-white/80 leading-relaxed">
              469 Seventh Avenue, 12th Floor<br/>New York, NY 10018
            </p>
            <p class="text-sm leading-relaxed mt-3">
              <a href="tel:+12126804040" class="text-white/90 hover:text-white">(212) 680-4040</a><br/>
              <a href="mailto:intake@friedmanfingerhut.com" class="text-white/90 hover:text-white">intake@friedmanfingerhut.com</a>
            </p>
            <p class="text-sm text-white/70 mt-3">
              Monday–Friday 9:00 am – 6:00 pm ET
            </p>
          </div>
          <div>
            <h4 class="text-[10.5px] uppercase tracking-[0.22em] font-semibold text-fl-brass-rule mb-3">Explore</h4>
            <ul class="flex flex-col gap-2 text-sm text-white/90">
              <li><a href="/attorneys" class="hover:text-white">Attorneys</a></li>
              <li><a href="/practice-areas" class="hover:text-white">Practice Areas</a></li>
              <li><a href="/results" class="hover:text-white">Results</a></li>
              <li><a href="/press" class="hover:text-white">Press</a></li>
              <li><a href="/blog" class="hover:text-white">Blog</a></li>
              <li><a href="/faq" class="hover:text-white">FAQ</a></li>
              <li><a href="/contact" class="hover:text-white">Contact</a></li>
            </ul>
          </div>
        </div>

        {site.feeNote && (
          <p class="mt-10 pt-6 border-t border-white/15 text-sm italic text-white/80">
            {site.feeNote}
          </p>
        )}
        <p class="text-xs text-white/70 mt-3">
          Admitted: New York · New Jersey · S.D.N.Y. · E.D.N.Y. · N.D.N.Y. · W.D.N.Y. · D.N.J. · Second Circuit Court of Appeals
        </p>

        <div class="mt-8 pt-5 border-t border-white/10 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-white/60">
          <span>© 2026 Friedman &amp; Fingerhut, PLLC</span>
          <span class="italic max-w-2xl">
            Attorney Advertising. Prior results do not guarantee a similar outcome.
            The information on this website is for general informational purposes only
            and is not legal advice. Contacting the firm does not create an
            attorney-client relationship.
          </span>
          <span class="shrink-0">
            <a href="/privacy" class="hover:text-white underline-offset-4 hover:underline">Privacy</a>
            <span class="mx-1 opacity-50">·</span>
            <a href="/terms" class="hover:text-white underline-offset-4 hover:underline">Legal Notices</a>
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
