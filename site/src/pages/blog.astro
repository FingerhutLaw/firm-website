---
import Layout from '../layouts/Layout.astro';
import { getEntry, getCollection } from 'astro:content';

const page = await getEntry('pages', 'blog');
const c = page!.data;

// Pull every blog post, filter out drafts, sort newest first.
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
---

<Layout title={c.title} description={c.description}>
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-24 pb-12">
    <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
      {c.blogHeroLabel}
    </p>
    <h1 class="font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight max-w-4xl">
      {c.blogHeroHeadline}
    </h1>
    <p class="mt-8 text-xl text-fl-ink-soft max-w-3xl leading-relaxed">
      {c.blogHeroSubheadline}
    </p>
  </section>

  <!-- Intro prose -->
  {c.blogIntro && (
    <section class="mx-auto max-w-3xl px-6 pb-16">
      <p class="text-lg text-fl-ink-soft leading-relaxed">{c.blogIntro}</p>
      {c.blogDisclaimer && (
        <p class="mt-6 text-sm text-fl-ink-soft italic leading-relaxed">{c.blogDisclaimer}</p>
      )}
    </section>
  )}

  <!-- Post list -->
  {posts.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-px bg-slate-200 border border-slate-200">
          {posts.map((post) => (
            <li class="bg-white">
              <a
                href={`/blog/${post.id}`}
                class="block h-full px-8 py-10 md:px-10 md:py-12 hover:bg-slate-50 transition-colors group"
              >
                <p class="text-fl-accent text-xs font-semibold uppercase tracking-widest mb-4">
                  {post.data.category}
                </p>
                <h2 class="font-serif font-medium text-2xl md:text-3xl text-fl-ink mb-4 group-hover:text-fl-accent transition-colors leading-snug">
                  {post.data.title}
                </h2>
                <p class="text-fl-ink-soft leading-relaxed">{post.data.description}</p>
                <span class="inline-block mt-6 text-fl-accent font-medium text-sm border-b-2 border-fl-accent pb-1 group-hover:border-fl-accent-2 group-hover:text-fl-accent-2 transition-colors">
                  Read the article &rarr;
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CTA -->
  {c.blogCTAHeading && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-8">
          {c.blogCTAHeading}
        </h2>
        <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-12">
          {c.blogCTABody}
        </p>
        <a
          href={c.blogCTAHref}
          class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
        >
          {c.blogCTAButton}
        </a>
      </div>
    </section>
  )}
</Layout>
