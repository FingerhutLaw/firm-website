---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const page = await getEntry('pages', 'privacy');
const c = page!.data;
const { Content } = await render(page!);
---

<Layout title={c.title} description={c.description}>
  <section class="mx-auto max-w-3xl px-6 pt-20 pb-24">
    <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
      Legal
    </p>
    <h1 class="font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight text-fl-ink">
      {c.heading ?? 'Privacy Policy'}
    </h1>
    {c.effectiveDate && (
      <p class="mt-4 text-sm text-fl-ink-soft italic">{c.effectiveDate}</p>
    )}
    <div class="prose-fl mt-12">
      <Content />
    </div>
  </section>
</Layout>
