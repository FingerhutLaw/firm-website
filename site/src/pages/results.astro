---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'content-results-page');
const c = page!.data;
const homepage = await getEntry('pages', 'homepage');
const h = homepage!.data;
---

<Layout title="Results — Fingerhut Law" description={c.description}>
  <!-- Hero -->
  <section
    class="relative bg-cover bg-center min-h-[40vh] flex items-center"
    style="background-image: url('/images/hero/results.jpg');"
  >
    <div class="absolute inset-0 bg-slate-900/60"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 w-full">
      <p class="text-xs uppercase tracking-widest text-white/80 font-semibold mb-6">
        {c.resultsHeroLabel}
      </p>
      <h1 class="text-white font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight max-w-4xl">
        {c.resultsHeroHeadline}
      </h1>
      <p class="mt-8 text-xl text-white/85 max-w-3xl leading-relaxed">
        {c.resultsHeroSubheadline}
      </p>
    </div>
  </section>

  <!-- Intro + disclaimer -->
  <section class="mx-auto max-w-3xl px-6 py-20">
    <p class="text-lg text-fl-ink-soft leading-relaxed">
      {c.resultsIntro}
    </p>
    {c.resultsDisclaimer && (
      <p class="mt-6 text-sm text-fl-ink-soft italic border-l-2 border-fl-accent pl-4">
        {c.resultsDisclaimer}
      </p>
    )}
  </section>

  <!-- Trial verdicts & appellate -->
  {c.verdicts && c.verdicts.length > 0 && (
    <section class="bg-slate-200 border-y border-slate-300">
      <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
        <h2 class="font-serif font-medium text-2xl md:text-3xl leading-tight tracking-tight text-fl-ink mb-8">
          {c.verdictsSectionLabel}
        </h2>
        <ul class="space-y-8">
          {c.verdicts.map((v) => (
            <li class="bg-white border border-slate-300 shadow-sm p-8 md:p-10">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-4">
                <p class="font-serif text-2xl md:text-3xl font-medium text-fl-accent tracking-tight">
                  {v.outcome}
                </p>
                {v.date && (
                  <p class="text-sm text-fl-ink-soft uppercase tracking-widest">{v.date}</p>
                )}
              </div>
              <p class="font-serif italic text-lg text-fl-ink mb-1">{v.caption}</p>
              {v.court && (
                <p class="text-sm text-fl-ink-soft mb-5">{v.court}</p>
              )}
              <p class="text-fl-ink-soft leading-relaxed">{v.summary}</p>
              {v.tags && (
                <p class="mt-5 text-xs uppercase tracking-widest text-fl-accent font-semibold">
                  {v.tags}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Trial settlements -->
  {c.trialSettlements && c.trialSettlements.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 py-20 md:py-24">
      <h2 class="font-serif font-medium text-2xl md:text-3xl leading-tight tracking-tight text-fl-ink mb-8">
        {c.trialSettlementsSectionLabel}
      </h2>
      <ul class="space-y-8">
        {c.trialSettlements.map((v) => (
          <li class="border border-slate-200 p-8 md:p-10">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-4">
              <p class="font-serif text-2xl md:text-3xl font-medium text-fl-accent tracking-tight">
                {v.outcome}
              </p>
              {v.date && (
                <p class="text-sm text-fl-ink-soft uppercase tracking-widest">{v.date}</p>
              )}
            </div>
            <p class="font-serif italic text-lg text-fl-ink mb-1">{v.caption}</p>
            {v.court && (
              <p class="text-sm text-fl-ink-soft mb-5">{v.court}</p>
            )}
            <p class="text-fl-ink-soft leading-relaxed">{v.summary}</p>
            {v.tags && (
              <p class="mt-5 text-xs uppercase tracking-widest text-fl-accent font-semibold">
                {v.tags}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Motion victories -->
  {c.motions && c.motions.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
        <h2 class="font-serif font-medium text-2xl md:text-3xl leading-tight tracking-tight text-fl-ink mb-8">
          {c.motionsSectionLabel}
        </h2>
        <ul class="space-y-8">
          {c.motions.map((v) => (
            <li class="bg-white border border-slate-200 p-8 md:p-10">
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-4">
                <p class="font-serif text-xl md:text-2xl font-medium text-fl-accent tracking-tight">
                  {v.outcome}
                </p>
                {v.date && (
                  <p class="text-sm text-fl-ink-soft uppercase tracking-widest">{v.date}</p>
                )}
              </div>
              <p class="font-serif italic text-lg text-fl-ink mb-1">{v.caption}</p>
              {v.court && (
                <p class="text-sm text-fl-ink-soft mb-5">{v.court}</p>
              )}
              <p class="text-fl-ink-soft leading-relaxed">{v.summary}</p>
              {v.tags && (
                <p class="mt-5 text-xs uppercase tracking-widest text-fl-accent font-semibold">
                  {v.tags}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Discovery decisions -->
  {c.discoveryDecisions && c.discoveryDecisions.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 py-20 md:py-24">
      <h2 class="font-serif font-medium text-2xl md:text-3xl leading-tight tracking-tight text-fl-ink mb-8">
        {c.discoverySectionLabel}
      </h2>
      <ul class="space-y-8">
        {c.discoveryDecisions.map((v) => (
          <li class="border border-slate-200 p-8 md:p-10">
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-4">
              <p class="font-serif text-xl md:text-2xl font-medium text-fl-accent tracking-tight">
                {v.outcome}
              </p>
              {v.date && (
                <p class="text-sm text-fl-ink-soft uppercase tracking-widest">{v.date}</p>
              )}
            </div>
            <p class="font-serif italic text-lg text-fl-ink mb-1">{v.caption}</p>
            {v.court && (
              <p class="text-sm text-fl-ink-soft mb-5">{v.court}</p>
            )}
            <p class="text-fl-ink-soft leading-relaxed">{v.summary}</p>
            {v.tags && (
              <p class="mt-5 text-xs uppercase tracking-widest text-fl-accent font-semibold">
                {v.tags}
              </p>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Notable (anonymized) settlements — dark band -->
  {c.settlements && c.settlements.length > 0 && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-6xl px-6 py-20 md:py-24">
        <h2 class="font-serif font-medium text-2xl md:text-3xl leading-tight tracking-tight mb-8">
          {c.settlementsSectionLabel}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
          {c.settlements.map((s) => (
            <li>
              <p class="font-serif text-4xl font-medium tracking-tight mb-3">
                {s.figure}
              </p>
              <p class="text-sm text-white/80 leading-relaxed">{s.description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Closing prose + disclaimer -->
  <section class="mx-auto max-w-3xl px-6 py-20">
    {c.resultsClosing && (
      <p class="text-fl-ink-soft leading-relaxed">{c.resultsClosing}</p>
    )}
    {c.resultsDisclaimer && (
      <p class="mt-6 text-sm text-fl-ink-soft italic border-l-2 border-fl-accent pl-4">
        {c.resultsDisclaimer}
      </p>
    )}
  </section>

  <!-- Final CTA (dark band) -->
  {c.resultsCTAHeading && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-8">
          {c.resultsCTAHeading}
        </h2>
        <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-8">
          {c.resultsCTABody}
        </p>
        {h.feeNote && (
          <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
            {h.feeNote}
          </p>
        )}
        <a
          href={c.resultsCTAHref}
          class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
        >
          {c.resultsCTAButton}
        </a>
      </div>
    </section>
  )}
</Layout>
