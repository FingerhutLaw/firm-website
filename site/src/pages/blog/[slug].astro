---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const homepage = await getEntry('pages', 'homepage');
const h = homepage!.data;

// Resolve related practice-area slugs to their entries for the sidebar.
const relatedSlugs = post.data.relatedPracticeAreas ?? [];
const relatedAreas = (
  await Promise.all(
    relatedSlugs.map(async (slug) => {
      const entry = await getEntry('practiceAreas', slug);
      return entry ?? null;
    }),
  )
).filter((e): e is NonNullable<typeof e> => e !== null);

const seoTitle = post.data.seoTitle ?? `${post.data.title} — Friedman & Fingerhut`;
const seoDescription = post.data.seoDescription ?? post.data.description;

const canonical = `https://friedmanfingerhut.com/blog/${post.id}`;

// Author pages: Josh has /josh; Steven's bio is /about.
const authorPages: Record<string, string> = {
  'Joshua Friedman': '/josh',
  'Steven Fingerhut': '/about',
};
const authorNames = post.data.authors ?? ['Steven Fingerhut'];
const authorSchema = authorNames.map((name) => ({
  '@type': 'Person',
  name,
  url: `https://friedmanfingerhut.com${authorPages[name] ?? '/about'}`,
}));
const lastUpdated = post.data.updatedDate ?? post.data.publishDate;
const lastUpdatedLabel = lastUpdated.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});

const faqSchema = post.data.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: post.data.faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://friedmanfingerhut.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://friedmanfingerhut.com/blog' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
  ],
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: lastUpdated.toISOString(),
  author: authorSchema.length === 1 ? authorSchema[0] : authorSchema,
  ...(post.data.reviewedBy && {
    reviewedBy: { '@type': 'Person', name: post.data.reviewedBy },
  }),
  publisher: {
    '@type': 'Organization',
    name: 'Friedman & Fingerhut',
  },
  mainEntityOfPage: canonical,
  articleSection: post.data.category,
  ...(post.data.heroImage && { image: `https://friedmanfingerhut.com${post.data.heroImage}` }),
};
---

<Layout title={seoTitle} description={seoDescription} {...(post.data.heroImage && { image: post.data.heroImage })}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-6 pt-24 pb-8">
    <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
      <a href="/blog" class="hover:underline">Blog</a>
      <span class="text-fl-ink-soft mx-2">/</span>
      <span class="text-fl-ink-soft normal-case tracking-normal font-normal">{post.data.category}</span>
    </p>
    <h1 class="font-serif font-medium text-4xl md:text-5xl leading-[1.15] tracking-tight">
      {post.data.title}
    </h1>
    {post.data.authors && (
      <p class="mt-6 text-sm text-fl-ink-soft">
        By {authorNames.map((name, i) => (
          <>
            {i > 0 && (i === authorNames.length - 1 ? ' and ' : ', ')}
            <a href={authorPages[name] ?? '/about'} class="text-fl-ink font-medium hover:text-fl-clay">{name}</a>
          </>
        ))}
        {post.data.reviewedBy && <> &middot; Reviewed by {post.data.reviewedBy}</>}
        &middot; Last updated <time datetime={lastUpdated.toISOString().slice(0, 10)}>{lastUpdatedLabel}</time>
      </p>
    )}
  </section>

  {post.data.heroImage && (
    <figure class="mx-auto max-w-4xl px-6 pb-10">
      <img
        src={post.data.heroImage}
        alt={post.data.heroImageAlt ?? ''}
        width="1600"
        height="900"
        fetchpriority="high"
        class="w-full h-auto rounded"
      />
    </figure>
  )}

  <!-- Body -->
  <section class="mx-auto max-w-3xl px-6 pb-20">
    <article class="prose-fl prose-fl-page">
      <Content />
    </article>
  </section>

  <!-- Related practice areas -->
  {relatedAreas.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
          Related Practice Areas
        </p>
        <ul class="space-y-4">
          {relatedAreas.map((area) => (
            <li>
              <a
                href={`/practice-areas/${area.id}`}
                class="group block"
              >
                <p class="font-serif text-xl md:text-2xl text-fl-ink group-hover:text-fl-clay transition-colors mb-1">
                  {area.data.name}
                </p>
                <p class="text-fl-ink-soft leading-relaxed">{area.data.intakeSummary}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-fl-accent text-white">
    <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
      <h2 class="font-serif font-medium text-3xl md:text-4xl leading-tight tracking-tight mb-8">
        If your rights at work have been violated, do not wait.
      </h2>
      <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-6">
        Employment claims in New York have short deadlines — sometimes as short as 180 days.
        Contact Friedman &amp; Fingerhut for a free, confidential consultation.
      </p>
      <p class="text-sm text-white/80 italic max-w-2xl mx-auto mb-4">
        Free, confidential consultation — no obligation.
      </p>
      {h.feeNote && (
        <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
          {h.feeNote}
        </p>
      )}
      <a
        href="/contact"
        class="inline-block bg-transparent text-fl-clay-peach border border-fl-clay-peach px-8 py-4 text-sm font-medium tracking-wide hover:bg-fl-clay-peach hover:text-fl-accent transition-colors"
      >
        Schedule a Consultation
      </a>
    </div>
  </section>
</Layout>
