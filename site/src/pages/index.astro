---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const homepage = await getEntry('pages', 'homepage');
const c = homepage!.data;
---

<Layout
  title="New York & New Jersey Employment Lawyers | Friedman & Fingerhut"
  description="Friedman & Fingerhut represents New York and New Jersey employees in workplace discrimination, harassment, retaliation, and wrongful termination claims. $60 million-plus recovered. Free confidential consultation."
>
  <!-- Hero — two-column: content left, partner portrait right.
       Midnight background with white H1 frames the brand statement;
       the ivory stats band at the bottom of the hero viewport breaks
       the dark expanse and draws the eye downward into the page. -->
  <section class="bg-fl-accent">
    <div class="max-w-[1120px] mx-auto px-6 pt-4 md:pt-6 pb-6 md:pb-7 grid grid-cols-1 md:grid-cols-[1fr_1.25fr] gap-6 md:gap-7 items-start md:items-center">
      <!-- Left: eyebrow, H1, big brand statement, descriptor, CTAs -->
      <div>
        {c.heroEyebrow && (
          <p class="text-[11px] md:text-xs uppercase tracking-[0.22em] text-fl-gold font-semibold mb-3">
            {c.heroEyebrow}
          </p>
        )}
        {c.heroBrandStatement && (
          <h1 class="font-serif font-medium text-white leading-[1.08] tracking-tight m-0 text-balance"
              style="font-size: clamp(26px, 3.6vw, 42px);">
            {c.heroBrandStatement.trim().split(/\n+/).map((line: string, i: number) => (
              <>{i > 0 && <br />}{line.trim()}</>
            ))}
          </h1>
        )}
        <p class="mt-4 md:mt-5 text-sm md:text-base leading-relaxed text-white/85 max-w-[32em]">
          {c.heroDescription ?? c.heroSubheadline}
        </p>
        <div class="mt-5 md:mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a
            href={c.heroCTAHref}
            class="inline-block bg-transparent text-fl-clay-peach border border-fl-clay-peach px-7 py-4 text-sm font-semibold uppercase tracking-[0.08em] hover:bg-fl-clay-peach hover:text-fl-accent transition-colors"
          >
            {c.heroCTAText}
          </a>
          <span class="text-sm text-white/70">
            or call
            <a href={c.phoneHref} class="font-semibold text-fl-clay-peach hover:underline">
              {c.phone}
            </a>
          </span>
        </div>
        {c.feeNote && (
          <p class="mt-3 text-xs italic text-white/60 max-w-[28em]">
            {c.feeNote}
          </p>
        )}
      </div>

      <!-- Right: full partner portrait, framed. max-h ties the image to
           viewport height so the whole picture lives above the fold on
           typical laptop screens, leaving room for the stats band below. -->
      <div class="relative flex justify-center">
        <img
          src={c.portraitImage}
          alt={c.portraitAlt}
          class="w-full max-h-[64vh] md:max-h-[72vh] h-auto object-contain rounded-lg shadow-[0_28px_56px_-28px_rgba(0,0,0,0.55),0_12px_24px_-14px_rgba(0,0,0,0.35)]"
        />
      </div>
    </div>

    <!-- Stats band — ivory, brass dividers, sits at bottom of the hero
         viewport to draw the eye downward -->
    <div class="border-y border-fl-brass-rule/50 bg-fl-bg-tint">
      <div id="fl-stats" class="fl-stats mx-auto max-w-[1240px] px-6 py-5 md:py-6 grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-fl-brass-rule/40">
        <div class="fl-stat flex flex-col items-center text-center py-3 md:py-0 md:px-6">
          <div class="font-serif font-medium text-fl-accent text-[32px] md:text-[40px] leading-none">
            <span class="fl-count" data-to="60" data-pre="$" data-suf="M+">$60M+</span>
          </div>
          <div class="mt-2 text-[11px] uppercase tracking-[0.18em] text-fl-ink-soft font-semibold">
            Recovered for workers
          </div>
        </div>
        <div class="fl-stat flex flex-col items-center text-center py-3 md:py-0 md:px-6">
          <div class="font-serif font-medium text-fl-accent text-[32px] md:text-[40px] leading-none">
            <span class="fl-count" data-to="25" data-suf="+">25+</span>
          </div>
          <div class="mt-2 text-[11px] uppercase tracking-[0.18em] text-fl-ink-soft font-semibold">
            Years combined experience
          </div>
        </div>
        <div class="fl-stat flex flex-col items-center text-center py-3 md:py-0 md:px-6">
          <div class="font-serif font-medium text-fl-accent text-[32px] md:text-[40px] leading-none">NY · NJ</div>
          <div class="mt-2 text-[11px] uppercase tracking-[0.18em] text-fl-ink-soft font-semibold">
            Workers only — never employers
          </div>
        </div>
      </div>
    </div>
  </section>

  {c.pressLogos && c.pressLogos.length > 0 && (
    <section class="bg-fl-bg border-b border-fl-brass-rule/30 py-5" aria-label={c.pressLabel ?? 'As Featured In'}>
      <div class="max-w-[1180px] mx-auto px-6 flex items-center justify-center flex-wrap gap-x-9 gap-y-3">
        <span class="text-[10.5px] font-sans font-semibold uppercase tracking-[0.22em] text-fl-brass md:pr-6 md:border-r md:border-fl-brass-rule/40">
          {c.pressLabel ?? 'As Featured In'}
        </span>
        <ul class="flex items-center justify-center flex-wrap gap-x-7 gap-y-2 list-none m-0 p-0">
          {c.pressLogos.map((logo: string) => (
            <li class="font-serif text-[15px] text-fl-ink-soft whitespace-nowrap">{logo}</li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <script>
    const flStats = document.getElementById('fl-stats');
    if (flStats) {
      const counts = flStats.querySelectorAll('.fl-count');
      const fmt = (el, v) => (el.dataset.pre || '') + v + (el.dataset.suf || '');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const run = () => counts.forEach((el) => {
          const to = Number(el.dataset.to), start = performance.now(), dur = 1100;
          const tick = (now) => {
            const p = Math.min(1, (now - start) / dur);
            el.textContent = fmt(el, Math.round((1 - Math.pow(1 - p, 3)) * to));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
        new IntersectionObserver((entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              counts.forEach((el) => { el.textContent = fmt(el, 0); });
              flStats.classList.add('fl-in');
              run();
              obs.disconnect();
            }
          });
        }, { threshold: 0.4 }).observe(flStats);
      }
    }
  </script>

  <!-- Practice areas grid (3 x 2) — moved up so visitors see what we handle quickly -->
  {c.practiceAreas && c.practiceAreas.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <p class="text-xs uppercase tracking-[0.22em] text-fl-brass font-semibold mb-6">
        {c.practiceAreasLabel}
      </p>
      <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight text-fl-ink max-w-3xl mb-16">
        {c.practiceAreasHeading}
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-fl-brass-rule/40 border border-fl-brass-rule/40">
        {c.practiceAreas.map((area) => (
          <li class="bg-white">
            <a
              href={area.href}
              class="relative block h-full px-8 py-10 hover:-translate-y-1 hover:shadow-xl hover:shadow-fl-clay/10 transition duration-300 group"
            >
              <h3 class="font-serif font-medium text-2xl text-fl-ink mb-3 group-hover:text-fl-clay transition-colors">
                {area.name}
              </h3>
              <p class="text-fl-ink-soft leading-relaxed">
                {area.tagline}
              </p>
              <span class="mt-4 inline-block text-sm font-medium text-fl-brass-ink group-hover:text-fl-brass transition-transform duration-300 group-hover:translate-x-1">Learn more &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      {c.practiceAreasCTA && (
        <div class="mt-12">
          <a
            href={c.practiceAreasCTAHref}
            class="text-fl-brass-ink font-medium border-b-2 border-fl-brass-rule pb-1 hover:text-fl-brass hover:border-fl-brass transition-colors"
          >
            {c.practiceAreasCTA} &rarr;
          </a>
        </div>
      )}
    </section>
  )}

  <!-- How We Practice — preview on homepage; full text lives at /how-we-practice -->
  <section class="bg-fl-bg-tint border-y border-fl-brass-rule/40">
    <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr] gap-12 md:gap-16 items-center">
        <div>
          <a href={c.howWePracticeCTAHref ?? '/how-we-practice'} class="inline-block">
            <p class="text-xs uppercase tracking-[0.22em] text-fl-brass font-semibold mb-8 hover:text-fl-brass-ink transition-colors">
              {c.howWePracticeLabel ?? 'How We Practice'} &rarr;
            </p>
          </a>
          <h2 class="font-serif font-medium text-4xl md:text-5xl leading-[1.1] tracking-tight text-fl-ink mb-10">
            {c.howWePracticeHeading ?? 'We stand with workers. We believe survivors.'}
          </h2>
          {c.howWePracticePreview && (
            <div class="space-y-5 text-lg text-fl-ink-soft leading-relaxed">
              {c.howWePracticePreview.trim().split(/\n\n+/).map((para: string) => (
                <p>{para.trim()}</p>
              ))}
            </div>
          )}
          <a
            href={c.howWePracticeCTAHref ?? '/how-we-practice'}
            class="mt-10 inline-block text-fl-brass-ink font-medium border-b-2 border-fl-brass-rule pb-1 hover:text-fl-brass hover:border-fl-brass transition-colors"
          >
            {c.howWePracticeCTA ?? 'Read our full approach'} &rarr;
          </a>
        </div>
        {c.howWePracticeImage && (
          <div class="flex justify-center">
            <img
              src={c.howWePracticeImage}
              alt={c.howWePracticeImageAlt ?? 'Steven Fingerhut and Joshua Friedman'}
              class="w-full max-w-xl rounded-lg shadow-[0_28px_56px_-28px_rgba(0,33,71,0.32),0_12px_24px_-14px_rgba(0,33,71,0.22)] object-cover"
              loading="lazy"
            />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- Results strip (dark band) -->
  {c.results && c.results.length > 0 && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p class="text-xs uppercase tracking-[0.22em] text-fl-brass-rule font-semibold mb-6">
          {c.resultsLabel}
        </p>
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-16 max-w-3xl">
          {c.resultsHeading}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
          {c.results.map((result) => (
            <li>
              <p class="font-serif text-4xl md:text-5xl font-medium tracking-tight mb-4 text-fl-gold">
                {result.figure}
              </p>
              <p class="text-sm md:text-base text-white/80 leading-relaxed">
                {result.description}
              </p>
            </li>
          ))}
        </ul>
        {c.resultsCTA && (
          <div class="mt-16">
            <a
              href={c.resultsCTAHref}
              class="text-fl-brass-rule font-medium border-b-2 border-fl-brass-rule/60 pb-1 hover:text-white hover:border-white transition-colors"
            >
              {c.resultsCTA} &rarr;
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Recognition marquee — moved here to sit next to Meet Steven as supporting credibility -->
  <section class="bg-fl-bg border-b border-fl-brass-rule/40 overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-10 pb-2">
      <p class="text-xs uppercase tracking-[0.22em] text-fl-brass font-semibold text-center">
        Recognition
      </p>
    </div>
    <div class="overflow-hidden py-8">
      <div class="fl-marquee-track">
        {[0, 1].map((copy) => (
          <ul
            class="flex items-center gap-28 px-14 shrink-0"
            aria-hidden={copy === 1 ? 'true' : undefined}
          >
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/super-lawyers-rising-stars.png" alt="Super Lawyers Rising Stars" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/multi-million-dollar-advocates-forum.png" alt="Multi-Million Dollar Advocates Forum lifetime member" class="max-h-28 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/american-institute-10-best.png" alt="American Institute of Legal Counsel — 10 Best" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/lead-counsel-rated.png" alt="Lead Counsel Rated" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/national-trial-lawyers-top-40-under-40.jpg" alt="The National Trial Lawyers — Top 40 Under 40" class="max-h-24 w-auto object-contain" loading="lazy" />
            </li>
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- In the news (3 cards) -->
  {c.news && c.news.length > 0 && (
    <section class="bg-fl-bg-tint border-y border-fl-brass-rule/40">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p class="text-xs uppercase tracking-[0.22em] text-fl-brass font-semibold mb-6">
          {c.newsLabel}
        </p>
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight text-fl-ink mb-16">
          {c.newsHeading}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {c.news.map((item) => (
            <li class="bg-white border border-fl-brass-rule/30 p-8 flex flex-col">
              <p class="text-xs uppercase tracking-[0.18em] text-fl-brass font-semibold mb-3">
                {item.publication}{item.date ? ` · ${item.date}` : ''}
              </p>
              <h3 class="font-serif font-medium text-xl leading-snug text-fl-ink mb-4">
                {item.headline}
              </h3>
              <p class="text-fl-ink-soft leading-relaxed flex-grow">
                {item.excerpt}
              </p>
              <a
                href={item.href}
                class="mt-6 text-fl-brass-ink font-medium hover:text-fl-brass transition-colors text-sm"
              >
                Read article &rarr;
              </a>
            </li>
          ))}
        </ul>
        {c.newsCTA && (
          <div class="mt-12">
            <a
              href={c.newsCTAHref}
              class="text-fl-brass-ink font-medium border-b-2 border-fl-brass-rule pb-1 hover:text-fl-brass hover:border-fl-brass transition-colors"
            >
              {c.newsCTA} &rarr;
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Final CTA (dark band) -->
  {c.finalCtaHeading && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-8">
          {c.finalCtaHeading}
        </h2>
        <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-6">
          {c.finalCtaBody}
        </p>
        <p class="text-sm text-white/80 italic max-w-2xl mx-auto mb-4">
          Free, confidential consultation — no obligation.
        </p>
        {c.feeNote && (
          <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
            {c.feeNote}
          </p>
        )}
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a
            href={c.finalCtaHref}
            class="inline-block bg-fl-brass text-white px-8 py-4 text-sm font-semibold uppercase tracking-[0.08em] hover:bg-fl-brass-ink transition-colors"
          >
            {c.finalCtaButton}
          </a>
          <span class="text-white/80 text-sm">
            or call
            <a href={c.phoneHref} class="text-white font-medium hover:underline">
              {c.phone}
            </a>
          </span>
        </div>
      </div>
    </section>
  )}
</Layout>
