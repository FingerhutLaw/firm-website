---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const homepage = await getEntry('pages', 'homepage');
const c = homepage!.data;

const howIPractice = await getEntry('pages', 'firm-values');
const { Content: HowIPracticeBody } = await render(howIPractice!);
---

<Layout>
  <!-- Hero -->
  <section
    class="relative bg-cover bg-right min-h-[55vh] flex items-center"
    style="background-image: url('/images/hero/home-hero.jpg');"
  >
    <div class="absolute inset-0 bg-slate-900/60"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-20 w-full">
      <h1 class="text-white font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight max-w-4xl">
        {c.heroHeadline}
      </h1>
      <p class="mt-8 text-xl text-white/85 max-w-2xl leading-relaxed">
        {c.heroSubheadline}
      </p>
      <div class="mt-12 flex flex-wrap items-center gap-6">
        <a
          href={c.heroCTAHref}
          class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
        >
          {c.heroCTAText}
        </a>
        <span class="text-white/80 text-sm">
          or call
          <a href={c.phoneHref} class="text-white font-medium underline underline-offset-4 hover:text-white/80">
            {c.phone}
          </a>
        </span>
      </div>
    </div>
  </section>

  <!-- Recognition marquee -->
  <section class="border-y border-slate-200 overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-10 pb-2">
      <p class="text-xs uppercase tracking-widest text-fl-ink-soft text-center">
        Recognition
      </p>
    </div>
    <div class="overflow-hidden py-8">
      <div class="fl-marquee-track">
        {[0, 1].map((copy) => (
          <ul
            class="flex items-center gap-28 px-14 shrink-0"
            aria-hidden={copy === 1 ? 'true' : undefined}
          >
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/super-lawyers-rising-stars.png" alt="Super Lawyers Rising Stars" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/multi-million-dollar-advocates-forum.png" alt="Multi-Million Dollar Advocates Forum lifetime member" class="max-h-28 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/american-institute-10-best.png" alt="American Institute of Legal Counsel — 10 Best" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/lead-counsel-rated.png" alt="Lead Counsel Rated" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- How I Practice — body from src/content/pages/firm-values.md -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-4xl px-6 py-24 md:py-32">
      <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-8">
        {howIPractice!.data.title ?? 'How I Practice'}
      </p>
      <h2 class="font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight text-fl-ink mb-12">
        I stand with victims.
      </h2>
      <div class="prose-fl">
        <HowIPracticeBody />
      </div>
    </div>
  </section>

  <!-- Practice areas grid (3 x 2) -->
  {c.practiceAreas && c.practiceAreas.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
        {c.practiceAreasLabel}
      </p>
      <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight text-fl-ink max-w-3xl mb-16">
        {c.practiceAreasHeading}
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-slate-200 border border-slate-200">
        {c.practiceAreas.map((area) => (
          <li class="bg-white">
            <a
              href={area.href}
              class="block h-full px-8 py-10 hover:bg-slate-50 transition-colors group"
            >
              <h3 class="font-serif font-medium text-2xl text-fl-ink mb-3 group-hover:text-fl-accent transition-colors">
                {area.name}
              </h3>
              <p class="text-fl-ink-soft leading-relaxed">
                {area.tagline}
              </p>
            </a>
          </li>
        ))}
      </ul>
      {c.practiceAreasCTA && (
        <div class="mt-12">
          <a
            href={c.practiceAreasCTAHref}
            class="text-fl-accent font-medium border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
          >
            {c.practiceAreasCTA} &rarr;
          </a>
        </div>
      )}
    </section>
  )}

  <!-- Results strip (dark band) -->
  {c.results && c.results.length > 0 && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p class="text-xs uppercase tracking-widest text-white/60 font-semibold mb-6">
          {c.resultsLabel}
        </p>
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-16 max-w-3xl">
          {c.resultsHeading}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
          {c.results.map((result) => (
            <li>
              <p class="font-serif text-4xl md:text-5xl font-medium tracking-tight mb-4">
                {result.figure}
              </p>
              <p class="text-sm md:text-base text-white/80 leading-relaxed">
                {result.description}
              </p>
            </li>
          ))}
        </ul>
        {c.resultsCTA && (
          <div class="mt-16">
            <a
              href={c.resultsCTAHref}
              class="text-white font-medium border-b-2 border-white/60 pb-1 hover:border-white transition-colors"
            >
              {c.resultsCTA} &rarr;
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Steven section (no "Meet Steven" label) -->
  <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 items-center">
      <div class="md:col-span-5">
        <img
          src={c.portraitImage}
          alt={c.portraitAlt}
          class="w-full max-w-md mx-auto md:mx-0 rounded-2xl shadow-xl aspect-[4/5] object-cover object-center"
          loading="lazy"
        />
      </div>
      <div class="md:col-span-7">
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight text-fl-ink">
          {c.meetStevenName}
        </h2>
        <p class="mt-2 text-fl-ink-soft italic">{c.meetStevenTitle}</p>
        <p class="mt-8 text-lg leading-relaxed text-fl-ink-soft max-w-xl">
          {c.meetStevenTagline}
        </p>
        <a
          href="/about"
          class="inline-block mt-10 text-fl-accent font-medium border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
        >
          Read full bio &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- In the news (3 cards) -->
  {c.news && c.news.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
          {c.newsLabel}
        </p>
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight text-fl-ink mb-16">
          {c.newsHeading}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {c.news.map((item) => (
            <li class="bg-white border border-slate-200 p-8 flex flex-col">
              <p class="text-xs uppercase tracking-widest text-fl-ink-soft mb-3">
                {item.publication}{item.date ? ` · ${item.date}` : ''}
              </p>
              <h3 class="font-serif font-medium text-xl leading-snug text-fl-ink mb-4">
                {item.headline}
              </h3>
              <p class="text-fl-ink-soft leading-relaxed flex-grow">
                {item.excerpt}
              </p>
              <a
                href={item.href}
                class="mt-6 text-fl-accent font-medium hover:text-fl-accent-2 transition-colors text-sm"
              >
                Read article &rarr;
              </a>
            </li>
          ))}
        </ul>
        {c.newsCTA && (
          <div class="mt-12">
            <a
              href={c.newsCTAHref}
              class="text-fl-accent font-medium border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
            >
              {c.newsCTA} &rarr;
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Final CTA (dark band) -->
  {c.finalCtaHeading && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-8">
          {c.finalCtaHeading}
        </h2>
        <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-8">
          {c.finalCtaBody}
        </p>
        {c.feeNote && (
          <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
            {c.feeNote}
          </p>
        )}
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a
            href={c.finalCtaHref}
            class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
          >
            {c.finalCtaButton}
          </a>
          <span class="text-white/80 text-sm">
            or call
            <a href={c.phoneHref} class="text-white font-medium hover:underline">
              {c.phone}
            </a>
          </span>
        </div>
      </div>
    </section>
  )}
</Layout>
