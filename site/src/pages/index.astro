---
// Homepage — v3 design (approved Nov 2026). Copy lives in
// src/content/pages/homepage.md; the consultation form posts to the same
// Formspree endpoint as /contact (formAction in contact.md).
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';
import { getGoogleRating, GOOGLE_REVIEWS_URL } from '../lib/googleRating';

const homepage = await getEntry('pages', 'homepage');
const c = homepage!.data;
const contact = (await getEntry('pages', 'contact'))!.data;

const google = await getGoogleRating();
const filledStars = Math.max(0, Math.min(5, Math.round(Number(google.rating))));
const stars = '★'.repeat(filledStars) + '☆'.repeat(5 - filledStars);
const reviewWord = google.count === 1 ? 'review' : 'reviews';

const CONSULT = '#consult';
const hasLink = (href?: string) => Boolean(href && href !== '#');
const paragraphs = (text: string) =>
  text.trim().split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
---

<Layout
  title="New York & New Jersey Employment Lawyers | Friedman & Fingerhut"
  description="Friedman & Fingerhut represents New York and New Jersey employees in workplace discrimination, harassment, retaliation, and wrongful termination claims. $60 million-plus recovered. Free confidential consultation."
  consultHref={CONSULT}
  mobileActionBar
  flushFooter
>
  <!-- ============ HERO ============ -->
  <section class="on-dark bg-linear-to-b from-v3-navy to-v3-navy-deep">
    <div class="mx-auto max-w-[1200px] px-5 md:px-10 pt-[26px] pb-5 md:pt-[72px] md:pb-16 flex flex-col lg:flex-row gap-5 lg:gap-14 lg:items-center">
      <div class="lg:flex-[1_1_480px] flex flex-col gap-3.5 md:gap-5">
        <p class="v3-eyebrow text-v3-gold text-[12px] md:text-[13px]">{c.heroEyebrow}</p>
        <!-- One H1. Phones see the short lead ("NY & NJ"); screen readers and
             search engines always get the full "New York & New Jersey". -->
        <h1 class="m-0 font-serif font-medium text-white text-[34px] md:text-[52px] lg:text-[60px] leading-[1.06] text-balance">
          <span class="max-md:sr-only">{c.heroH1Lead}</span><span class="md:hidden" aria-hidden="true">{c.heroH1LeadShort}</span>
          {c.heroH1Rest}
        </h1>
        <p class="m-0 text-base md:text-lg leading-[1.55] text-v3-on-navy max-w-[460px]">
          {c.heroDescription}
        </p>
        <div class="flex flex-wrap items-center gap-5 mt-1 md:mt-2">
          <a href={c.heroCTAHref ?? CONSULT} class="v3-btn max-md:w-full min-h-[54px] md:min-h-14 px-8 text-base">
            {c.heroCTAText}
          </a>
          <span class="hidden md:inline text-[15px] text-v3-on-navy">
            or call / text <a href={c.phoneHref} class="text-white font-semibold no-underline hover:text-v3-clay-light">{c.phone}</a>
          </span>
        </div>
        <p class="m-0 text-[13px] md:text-sm text-v3-on-navy-soft max-md:text-center">{c.heroNote}</p>
      </div>

      <figure class="lg:flex-[1_1_440px] m-0 flex flex-col gap-2.5 mt-1.5 lg:mt-0">
        <img
          src={c.portraitImage}
          alt={c.portraitAlt}
          width="1253"
          height="853"
          fetchpriority="high"
          class="w-full h-[190px] sm:h-auto sm:aspect-[3/2] object-cover object-[center_30%] sm:object-center rounded-lg border border-v3-gold/50"
        />
        <figcaption class="text-[13px] text-v3-on-navy-soft">{c.heroCaption}</figcaption>
      </figure>
    </div>
  </section>

  <!-- ============ STATS + AS FEATURED IN ============
       Phones: three stats continue the navy hero. Desktop: four stats on cream. -->
  <section aria-label="The firm at a glance" class="on-dark-mobile bg-v3-navy-deep md:bg-v3-cream-light md:border-b md:border-v3-rule">
    <ul class="mx-auto max-w-[1200px] px-5 md:px-10 pt-1 pb-6 md:py-6 grid grid-cols-3 md:grid-cols-4 gap-2 md:gap-4 text-center list-none m-0">
      <li class="order-1">
        <p class="m-0 font-serif font-semibold text-2xl md:text-4xl leading-tight text-v3-gold-figure md:text-v3-navy">$60M+</p>
        <p class="m-0 text-[11px] md:text-xs text-v3-on-navy md:text-v3-brass md:font-semibold md:tracking-[0.12em] md:uppercase">Recovered for workers</p>
      </li>
      <li class="order-3 md:order-2">
        <p class="m-0 font-serif font-semibold text-2xl md:text-4xl leading-tight text-v3-gold-figure md:text-v3-navy">25+</p>
        <p class="m-0 text-[11px] md:text-xs text-v3-on-navy md:text-v3-brass md:font-semibold md:tracking-[0.12em] md:uppercase">Years combined experience</p>
      </li>
      <li class="order-2 md:order-3">
        <a href="#results" class="block no-underline">
          <p class="m-0 font-serif font-semibold text-2xl md:text-4xl leading-tight text-v3-gold-figure md:text-v3-navy">
            {google.rating} <span class="md:text-v3-star" aria-hidden="true">★</span><span class="sr-only"> out of 5 stars on Google</span>
          </p>
          <p class="m-0 text-[11px] md:text-xs text-v3-on-navy md:text-v3-brass md:font-semibold md:tracking-[0.12em] md:uppercase">{google.count} Google {reviewWord}</p>
        </a>
      </li>
      <li class="order-4 max-md:hidden">
        <p class="m-0 font-serif font-semibold text-4xl leading-tight text-v3-navy">No fee</p>
        <p class="m-0 text-xs text-v3-brass font-semibold tracking-[0.12em] uppercase">Unless we win</p>
      </li>
    </ul>
  </section>

  {c.pressLogos && c.pressLogos.length > 0 && (
    <section aria-label={c.pressLabel ?? 'As featured in'} class="bg-v3-cream-light border-b border-v3-rule">
      <div class="mx-auto max-w-[1200px] px-5 md:px-10 py-4 md:pt-3.5 md:pb-[22px] flex flex-wrap items-center justify-center gap-x-9 gap-y-2">
        <p class="v3-eyebrow text-v3-brass text-xs w-full md:w-auto text-center">{c.pressLabel ?? 'As featured in'}</p>
        <ul class="flex flex-wrap items-center justify-center gap-x-7 md:gap-x-9 gap-y-1 list-none m-0 p-0">
          {c.pressLogos.map((logo) => {
            const item = typeof logo === 'string' ? { name: logo, href: undefined } : logo;
            return (
              <li class="font-serif font-medium text-[17px] md:text-[19px] text-[#4A4F5A] whitespace-nowrap">
                {hasLink(item.href) ? (
                  <a href={item.href} class="text-inherit no-underline border-b border-v3-clay-hover/35 hover:text-v3-clay-hover">{item.name}</a>
                ) : (
                  item.name
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  )}

  <!-- ============ PRACTICE AREAS ============ -->
  {c.practiceAreas && c.practiceAreas.length > 0 && (
    <section class="mx-auto max-w-[1200px] px-5 md:px-10 py-14 md:py-[72px] flex flex-col gap-7">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 class="m-0 font-serif font-medium text-[30px] md:text-[40px] leading-[1.1] text-v3-navy">{c.practiceAreasHeading}</h2>
        <a href={c.practiceAreasCTAHref} class="v3-link">{c.practiceAreasCTA} &rarr;</a>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 list-none m-0 p-0">
        {c.practiceAreas.map((area) => (
          <li class="flex">
            <a href={area.href} class="v3-card w-full">
              <h3 class="m-0 font-serif font-semibold text-2xl text-v3-navy">{area.name}</h3>
              <span class="text-[15px] leading-normal text-v3-ink-soft">{area.tagline}</span>
              <span class="v3-link self-start mt-1">Learn more &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      <a href={CONSULT} class="v3-card bg-v3-sand md:flex-row md:items-center md:justify-between md:gap-4">
        <span class="text-base text-v3-ink">
          <strong class="font-serif font-semibold text-[22px] text-v3-navy mr-2.5">{c.practiceAreasOtherHeading}</strong>
          {c.practiceAreasOtherBody}
        </span>
        <span class="v3-link self-start md:self-auto whitespace-nowrap">{c.practiceAreasOtherCTA} &rarr;</span>
      </a>
    </section>
  )}

  <!-- ============ RESULTS + REVIEWS ============ -->
  <section id="results" class="on-dark scroll-mt-20 bg-linear-to-b from-v3-navy to-v3-navy-deep">
    <div class="mx-auto max-w-[1200px] px-5 md:px-10 py-14 md:py-[72px] flex flex-col lg:flex-row gap-12">
      <div class="lg:flex-[3_1_560px] flex flex-col gap-5">
        <p class="v3-eyebrow text-v3-gold">{c.resultsLabel}</p>
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="m-0 font-serif font-medium text-[32px] md:text-[40px] leading-tight text-white">{c.resultsHeading}</h2>
          <a href={c.resultsCTAHref} class="v3-link-dark">{c.resultsCTA} &rarr;</a>
        </div>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 list-none m-0 p-0">
          {c.results?.map((r) => (
            <li class="p-[22px] bg-white/5 border-t-2 border-v3-gold">
              <p class="m-0 font-serif font-semibold text-4xl text-v3-gold-figure">{r.figure}</p>
              <p class="m-0 text-[15px] leading-normal text-v3-on-navy">{r.description}</p>
            </li>
          ))}
        </ul>
        <p class="m-0 text-[13px] text-v3-on-navy-muted">{c.priorResultsNote}</p>
      </div>

      <div class="lg:flex-[2_1_340px] flex flex-col gap-3.5">
        <h3 class="v3-eyebrow text-v3-gold">{c.reviewsLabel}</h3>
        <div class="p-[22px] bg-v3-cream-light rounded-lg flex items-center gap-[18px]">
          <p class="m-0 font-serif font-semibold text-[52px] leading-none text-v3-navy">{google.rating}</p>
          <div class="flex flex-col gap-1">
            <p class="m-0 text-v3-star text-xl tracking-[2px]" aria-hidden="true">{stars}</p>
            <p class="m-0 text-sm text-v3-ink-soft">
              <span class="sr-only">Rated {google.rating} out of 5 from </span>{google.count} {reviewWord} on Google
            </p>
          </div>
        </div>
        {c.reviews?.map((review) => (
          <figure class="m-0 p-[22px] bg-v3-cream-light rounded-lg flex flex-col gap-2.5">
            <p class="m-0 text-v3-star tracking-[2px]" aria-hidden="true">★★★★★</p>
            <span class="sr-only">Five-star Google review</span>
            <blockquote class="m-0 flex flex-col gap-[1.35em] font-serif italic font-medium text-xl leading-[1.35] text-v3-ink">
              {paragraphs(review.quote).map((para) => <p class="m-0">{para}</p>)}
            </blockquote>
            <figcaption class="text-[13px] text-v3-brass font-semibold">{review.name}</figcaption>
          </figure>
        ))}
        <p class="m-0 text-[13px] text-v3-on-navy-muted">{c.priorResultsNote}</p>
        <a href={GOOGLE_REVIEWS_URL} class="v3-link-dark self-start">
          Read all {google.count} {reviewWord} on Google &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- ============ HOW WE PRACTICE ============ -->
  <section class="mx-auto max-w-[1200px] px-5 md:px-10 py-14 md:py-[72px] flex flex-col lg:flex-row gap-10 lg:gap-14 lg:items-center">
    <div class="lg:flex-[1_1_480px] flex flex-col gap-[18px]">
      <p class="v3-eyebrow text-v3-brass">{c.howWePracticeLabel}</p>
      <h2 class="m-0 font-serif font-medium text-[32px] md:text-[40px] leading-[1.1] text-v3-navy">{c.howWePracticeHeading}</h2>
      {c.howWePracticeQuote && (
        <blockquote class="my-1 mx-0 pl-5 border-l-[3px] border-v3-gold font-serif italic font-medium text-[22px] md:text-[26px] leading-[1.3] text-v3-navy">
          {c.howWePracticeQuote}
        </blockquote>
      )}
      <p class="m-0 text-base leading-[1.65] text-v3-ink-soft">{c.howWePracticeBody}</p>
      <a href={c.howWePracticeCTAHref ?? '/how-we-practice'} class="v3-link self-start">{c.howWePracticeCTA} &rarr;</a>
    </div>
    {c.howWePracticeImage && (
      <img
        src={c.howWePracticeImage}
        alt={c.howWePracticeImageAlt}
        width="1213"
        height="914"
        loading="lazy"
        class="lg:flex-[1_1_400px] min-w-0 w-full aspect-[4/3] object-cover rounded-lg border border-[#D9C9A3]"
      />
    )}
  </section>

  <!-- ============ RECOGNITION + IN THE NEWS ============ -->
  <section class="bg-v3-sand">
    <div class="mx-auto max-w-[1200px] px-5 md:px-10 py-12 md:py-14 flex flex-col gap-6">
      {c.recognition && c.recognition.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-7 gap-y-3">
          <h2 class="v3-eyebrow text-v3-brass">{c.recognitionLabel}</h2>
          <ul class="v3-dotlist">
            {c.recognition.map((item) => (
              <li class="font-serif font-semibold text-lg text-v3-navy">
                {hasLink(item.href) ? (
                  <a href={item.href} class="text-v3-navy no-underline border-b-[1.5px] border-v3-clay-hover/35 hover:text-v3-clay-hover hover:border-current">{item.name}</a>
                ) : (
                  item.name
                )}
              </li>
            ))}
          </ul>
        </div>
      )}

      {c.news && c.news.length > 0 && (
        <>
          <div class="flex flex-wrap items-end justify-between gap-4">
            <h2 class="m-0 font-serif font-medium text-[30px] md:text-[34px] text-v3-navy">{c.newsHeading}</h2>
            <a href={c.newsCTAHref} class="v3-link">{c.newsCTA} &rarr;</a>
          </div>
          <ul class="grid grid-cols-1 md:grid-cols-3 gap-4 list-none m-0 p-0">
            {c.news.map((item) => {
              const kicker = [item.publication, item.tag].filter(Boolean).join(' · ');
              const inner = (
                <>
                  <span class="text-xs tracking-[0.14em] uppercase text-v3-brass font-semibold">{kicker}</span>
                  <h3 class="m-0 font-serif font-semibold text-[22px] leading-[1.2] text-v3-navy">{item.headline}</h3>
                </>
              );
              return (
                <li class="flex">
                  {hasLink(item.href) ? (
                    <a href={item.href} class="v3-card w-full">
                      {inner}
                      <span class="v3-link self-start">Read article &rarr;</span>
                    </a>
                  ) : (
                    <div class="v3-card w-full">{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </>
      )}
    </div>
  </section>

  <!-- ============ CONSULTATION (every consultation button lands here) ============ -->
  <section id="consult" class="scroll-mt-20 bg-v3-cream-light border-t-[3px] border-v3-gold">
    <div class="mx-auto max-w-[1200px] px-5 md:px-10 py-[22px] md:py-20 flex flex-col lg:flex-row gap-4 md:gap-14 lg:items-start">
      <div class="lg:flex-[1_1_420px] flex flex-col gap-3.5 md:gap-[18px]">
        <h2 class="m-0 font-serif font-medium text-[30px] md:text-[46px] leading-[1.08] text-v3-navy">
          <span class="md:hidden">{c.finalCtaHeadingShort ?? c.finalCtaHeading}</span>
          <span class="max-md:hidden">{c.finalCtaHeading}</span>
        </h2>
        <p class="m-0 text-[15px] md:text-[17px] leading-[1.6] text-v3-ink-soft">{c.finalCtaBody}</p>
        {c.consultPoints && (
          <ul class="max-md:hidden flex flex-col gap-2.5 text-base text-v3-ink list-none m-0 p-0">
            {c.consultPoints.map((point) => (
              <li><span aria-hidden="true">✓&nbsp; </span>{point}</li>
            ))}
          </ul>
        )}
        <p class="max-md:hidden m-0 text-base text-v3-ink-soft">
          Prefer to talk? Call or text <a href={c.phoneHref} class="font-semibold text-v3-clay-hover">{c.phone}</a>
        </p>
      </div>

      <div class="lg:flex-[1_1_440px] md:p-8 md:bg-white md:border md:border-v3-rule md:rounded-[10px] md:shadow-[0_10px_30px_rgba(11,31,63,0.08)]">
        <form
          id="consult-form"
          action={contact.formAction}
          method="POST"
          class="flex flex-col gap-3.5 md:gap-4"
        >
          <h3 class="max-md:sr-only m-0 font-serif font-semibold text-[26px] text-v3-navy">{c.consultFormHeading}</h3>

          {/* Same Formspree endpoint + field names as the /contact form. */}
          {contact.formSubject && <input type="hidden" name="_subject" value={contact.formSubject} />}
          {contact.formSuccessRedirect && <input type="hidden" name="_next" value={contact.formSuccessRedirect} />}
          <input
            type="text"
            name="_gotcha"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;height:0;width:0;opacity:0;"
          />

          <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
            <label class="v3-label" for="consult-name">
              Full name
              <input id="consult-name" name="name" type="text" required autocomplete="name" class="v3-field" />
            </label>
            <label class="v3-label" for="consult-phone">
              Phone
              <input id="consult-phone" name="phone" type="tel" required autocomplete="tel" class="v3-field" />
            </label>
          </div>
          <label class="v3-label" for="consult-email">
            <span>Email <span class="font-normal text-v3-muted">(optional)</span></span>
            <input id="consult-email" name="email" type="email" autocomplete="email" class="v3-field" />
          </label>
          <label class="v3-label" for="consult-message">
            <span>What happened?<span class="max-md:hidden"> A sentence or two is enough.</span></span>
            <textarea id="consult-message" name="message" rows="4" class="v3-field resize-y"></textarea>
          </label>

          <button type="submit" class="v3-btn min-h-14 text-base">{c.consultSubmitLabel}</button>
          <p id="consult-error" hidden role="alert" class="m-0 text-sm text-v3-clay-hover font-semibold">
            Something went wrong sending your request. Please try again, or call or text {c.phone}.
          </p>
          <p class="m-0 text-xs leading-normal text-v3-muted">{c.consultDisclaimer}</p>
        </form>

        <div id="consult-success" hidden tabindex="-1" role="status" class="flex flex-col gap-3">
          <p class="m-0 font-serif font-semibold text-[26px] text-v3-navy">Request received.</p>
          <p class="m-0 text-base leading-relaxed text-v3-ink-soft">{c.consultSuccess}</p>
          <p class="m-0 text-base text-v3-ink-soft">
            Need us sooner? Call or text <a href={c.phoneHref} class="font-semibold text-v3-clay-hover">{c.phone}</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <script>
    // Submit the consultation form in place (Formspree JSON API) so the
    // visitor sees a success message without leaving the page. Without JS
    // the form still posts normally and Formspree redirects to /contact/thanks.
    const form = document.getElementById('consult-form') as HTMLFormElement | null;
    const success = document.getElementById('consult-success');
    const error = document.getElementById('consult-error');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const label = button?.textContent ?? '';
      const data = new FormData(form);
      // Email is optional; don't send an empty one.
      if (!String(data.get('email') ?? '').trim()) data.delete('email');
      if (error) error.hidden = true;
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: data,
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.hidden = true;
        if (success) {
          success.hidden = false;
          success.focus();
        }
      } catch {
        if (error) error.hidden = false;
        if (button) {
          button.disabled = false;
          button.textContent = label;
        }
      }
    });
  </script>
</Layout>
