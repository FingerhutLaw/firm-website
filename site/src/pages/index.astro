---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const homepage = await getEntry('pages', 'homepage');
const c = homepage!.data;

const howIPractice = await getEntry('pages', 'firm-values');
const { Content: HowIPracticeBody } = await render(howIPractice!);
---

<Layout
  title="New York & New Jersey Employment Lawyer | Fingerhut Law"
  description="Fingerhut Law represents New York and New Jersey employees in workplace discrimination, harassment, retaliation, and wrongful termination claims. Over $30 million recovered. Free confidential consultation."
>
  <!-- Hero — portrait LEFT, copy RIGHT, very faded courthouse photo -->
  <section
    class="relative bg-white bg-cover bg-center border-b border-slate-200"
    style="background-image: url('/images/hero/home-hero.jpg');"
  >
    <div class="absolute inset-0 bg-white/70"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 md:py-24 grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center md:items-start">
      <div class="md:col-span-5">
        <img
          src={c.portraitImage}
          alt={c.portraitAlt}
          class="w-full max-w-sm mx-auto md:mx-0 rounded-2xl shadow-xl aspect-[4/5] object-cover object-center"
        />
        <div class="mt-6 text-center md:text-left">
          <a
            href="/about"
            class="inline-block text-fl-accent font-semibold border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
          >
            Read full bio &rarr;
          </a>
        </div>
      </div>
      <div class="md:col-span-7 md:pt-2">
        <h1 class="font-serif font-medium text-5xl md:text-6xl leading-[1.05] tracking-tight text-fl-ink">
          <span class="fl-mask"><span class="fl-rise">Steven Fingerhut</span></span>
        </h1>
        <p class="mt-4 font-serif font-medium italic text-xl md:text-2xl text-fl-accent fl-fade fl-fade-1">
          New York and New Jersey Employment Lawyer
        </p>
        <p class="mt-6 md:mt-8 text-lg leading-relaxed text-fl-ink max-w-xl fl-fade fl-fade-1">
          $30 million-plus recovered for workers in discrimination, harassment,
          retaliation, and wrongful termination cases.
        </p>
        <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-6 fl-fade fl-fade-2">
          <a
            href={c.heroCTAHref}
            class="inline-block bg-fl-accent text-white px-8 py-4 text-sm font-semibold tracking-wide hover:bg-fl-accent-2 transition-colors"
          >
            {c.heroCTAText}
          </a>
          <span class="text-fl-ink-soft text-sm">
            or call
            <a href={c.phoneHref} class="text-fl-accent font-semibold hover:underline">
              {c.phone}
            </a>
          </span>
        </div>
        <p class="mt-6 text-sm text-fl-ink-soft italic fl-fade fl-fade-2">
          Free, confidential consultation — no obligation. No fee unless I obtain a recovery.
        </p>
      </div>
    </div>
  </section>

  <!-- Credibility stats — fade-up + count once on scroll -->
  <section class="bg-fl-accent text-white">
    <div class="mx-auto max-w-6xl px-6 pt-16 md:pt-20">
      <p class="text-center font-serif italic text-xl md:text-2xl text-white/90 max-w-3xl mx-auto leading-snug">
        Employment law for workers in New York and New Jersey.
      </p>
    </div>
    <div id="fl-stats" class="fl-stats mx-auto max-w-6xl px-6 pt-12 pb-16 md:pb-20 grid grid-cols-2 md:grid-cols-4 gap-10">
      <div class="fl-stat">
        <div class="font-serif font-medium text-5xl md:text-6xl leading-none"><span class="fl-count" data-to="30" data-pre="$" data-suf="M+">$30M+</span></div>
        <div class="mt-3 text-xs uppercase tracking-widest text-white/70">Recovered for workers</div>
      </div>
      <div class="fl-stat">
        <div class="font-serif font-medium text-5xl md:text-6xl leading-none"><span class="fl-count" data-to="10" data-suf="+">10+</span></div>
        <div class="mt-3 text-xs uppercase tracking-widest text-white/70">Years litigating</div>
      </div>
      <div class="fl-stat">
        <div class="font-serif font-medium text-5xl md:text-6xl leading-none"><span class="fl-count" data-to="100" data-suf="%">100%</span></div>
        <div class="mt-3 text-xs uppercase tracking-widest text-white/70">Workers, never employers</div>
      </div>
      <div class="fl-stat">
        <div class="font-serif font-medium text-5xl md:text-6xl leading-none">NY · NJ</div>
        <div class="mt-3 text-xs uppercase tracking-widest text-white/70">Admitted in both states</div>
      </div>
    </div>
  </section>
  <script>
    const flStats = document.getElementById('fl-stats');
    if (flStats) {
      const counts = flStats.querySelectorAll('.fl-count');
      const fmt = (el, v) => (el.dataset.pre || '') + v + (el.dataset.suf || '');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const run = () => counts.forEach((el) => {
          const to = Number(el.dataset.to), start = performance.now(), dur = 1100;
          const tick = (now) => {
            const p = Math.min(1, (now - start) / dur);
            el.textContent = fmt(el, Math.round((1 - Math.pow(1 - p, 3)) * to));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
        new IntersectionObserver((entries, obs) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              counts.forEach((el) => { el.textContent = fmt(el, 0); });
              flStats.classList.add('fl-in');
              run();
              obs.disconnect();
            }
          });
        }, { threshold: 0.4 }).observe(flStats);
      }
    }
  </script>

  <!-- Practice areas grid (3 x 2) — moved up so visitors see WHAT I handle quickly -->
  {c.practiceAreas && c.practiceAreas.length > 0 && (
    <section class="mx-auto max-w-6xl px-6 py-24 md:py-32">
      <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
        {c.practiceAreasLabel}
      </p>
      <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight text-fl-ink max-w-3xl mb-16">
        {c.practiceAreasHeading}
      </h2>
      <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-slate-200 border border-slate-200">
        {c.practiceAreas.map((area) => (
          <li class="bg-white">
            <a
              href={area.href}
              class="relative block h-full px-8 py-10 hover:bg-slate-50 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/10 transition duration-300 group"
            >
              <h3 class="font-serif font-medium text-2xl text-fl-ink mb-3 group-hover:text-fl-accent transition-colors">
                {area.name}
              </h3>
              <p class="text-fl-ink-soft leading-relaxed">
                {area.tagline}
              </p>
              <span class="mt-4 inline-block text-sm font-medium text-fl-accent transition-transform duration-300 group-hover:translate-x-1">Learn more &rarr;</span>
            </a>
          </li>
        ))}
      </ul>
      {c.practiceAreasCTA && (
        <div class="mt-12">
          <a
            href={c.practiceAreasCTAHref}
            class="text-fl-accent font-medium border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
          >
            {c.practiceAreasCTA} &rarr;
          </a>
        </div>
      )}
    </section>
  )}

  <!-- How I Practice — body from src/content/pages/firm-values.md -->
  <section class="bg-slate-50 border-y border-slate-200">
    <div class="mx-auto max-w-4xl px-6 py-24 md:py-32">
      <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-8">
        {howIPractice!.data.title ?? 'How I Practice'}
      </p>
      <h2 class="font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight text-fl-ink mb-12">
        I stand with workers.<br />I believe survivors.
      </h2>
      <div class="prose-fl">
        <HowIPracticeBody />
      </div>
    </div>
  </section>

  <!-- Results strip (dark band) -->
  {c.results && c.results.length > 0 && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p class="text-xs uppercase tracking-widest text-white/60 font-semibold mb-6">
          {c.resultsLabel}
        </p>
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-16 max-w-3xl">
          {c.resultsHeading}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
          {c.results.map((result) => (
            <li>
              <p class="font-serif text-4xl md:text-5xl font-medium tracking-tight mb-4">
                {result.figure}
              </p>
              <p class="text-sm md:text-base text-white/80 leading-relaxed">
                {result.description}
              </p>
            </li>
          ))}
        </ul>
        {c.resultsCTA && (
          <div class="mt-16">
            <a
              href={c.resultsCTAHref}
              class="text-white font-medium border-b-2 border-white/60 pb-1 hover:border-white transition-colors"
            >
              {c.resultsCTA} &rarr;
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Recognition marquee — moved here to sit next to Meet Steven as supporting credibility -->
  <section class="border-b border-slate-200 overflow-hidden">
    <div class="mx-auto max-w-6xl px-6 pt-10 pb-2">
      <p class="text-xs uppercase tracking-widest text-fl-ink-soft text-center">
        Recognition
      </p>
    </div>
    <div class="overflow-hidden py-8">
      <div class="fl-marquee-track">
        {[0, 1].map((copy) => (
          <ul
            class="flex items-center gap-28 px-14 shrink-0"
            aria-hidden={copy === 1 ? 'true' : undefined}
          >
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/super-lawyers-rising-stars.png" alt="Super Lawyers Rising Stars" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/multi-million-dollar-advocates-forum.png" alt="Multi-Million Dollar Advocates Forum lifetime member" class="max-h-28 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/american-institute-10-best.png" alt="American Institute of Legal Counsel — 10 Best" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/lead-counsel-rated.png" alt="Lead Counsel Rated" class="max-h-20 w-auto object-contain" loading="lazy" />
            </li>
            <li class="flex items-center h-28 shrink-0">
              <img src="/images/about/badges/national-trial-lawyers-top-40-under-40.jpg" alt="The National Trial Lawyers — Top 40 Under 40" class="max-h-24 w-auto object-contain" loading="lazy" />
            </li>
          </ul>
        ))}
      </div>
    </div>
  </section>

  <!-- In the news (3 cards) -->
  {c.news && c.news.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="mx-auto max-w-6xl px-6 py-24 md:py-32">
        <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
          {c.newsLabel}
        </p>
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight text-fl-ink mb-16">
          {c.newsHeading}
        </h2>
        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {c.news.map((item) => (
            <li class="bg-white border border-slate-200 p-8 flex flex-col">
              <p class="text-xs uppercase tracking-widest text-fl-ink-soft mb-3">
                {item.publication}{item.date ? ` · ${item.date}` : ''}
              </p>
              <h3 class="font-serif font-medium text-xl leading-snug text-fl-ink mb-4">
                {item.headline}
              </h3>
              <p class="text-fl-ink-soft leading-relaxed flex-grow">
                {item.excerpt}
              </p>
              <a
                href={item.href}
                class="mt-6 text-fl-accent font-medium hover:text-fl-accent-2 transition-colors text-sm"
              >
                Read article &rarr;
              </a>
            </li>
          ))}
        </ul>
        {c.newsCTA && (
          <div class="mt-12">
            <a
              href={c.newsCTAHref}
              class="text-fl-accent font-medium border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
            >
              {c.newsCTA} &rarr;
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Final CTA (dark band) -->
  {c.finalCtaHeading && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-8">
          {c.finalCtaHeading}
        </h2>
        <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-6">
          {c.finalCtaBody}
        </p>
        <p class="text-sm text-white/80 italic max-w-2xl mx-auto mb-4">
          Free, confidential consultation — no obligation.
        </p>
        {c.feeNote && (
          <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
            {c.feeNote}
          </p>
        )}
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a
            href={c.finalCtaHref}
            class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
          >
            {c.finalCtaButton}
          </a>
          <span class="text-white/80 text-sm">
            or call
            <a href={c.phoneHref} class="text-white font-medium hover:underline">
              {c.phone}
            </a>
          </span>
        </div>
      </div>
    </section>
  )}
</Layout>
