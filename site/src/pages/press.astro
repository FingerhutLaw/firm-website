---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'press');
const c = page!.data;
const homepage = await getEntry('pages', 'homepage');
const h = homepage!.data;
---

<Layout title={c.title} description={c.description}>
  <!-- Hero -->
  <section
    class="relative bg-cover bg-bottom min-h-[40vh] flex items-center"
    style="background-image: url('/images/hero/press.jpg');"
  >
    <div class="absolute inset-0 bg-slate-900/60"></div>
    <div class="relative mx-auto max-w-6xl px-6 py-16 w-full">
      <p class="text-xs uppercase tracking-widest text-white/80 font-semibold mb-6">
        {c.pressHeroLabel}
      </p>
      <h1 class="text-white font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight max-w-4xl">
        {c.pressHeroHeadline}
      </h1>
      <p class="mt-8 text-xl text-white/85 max-w-3xl leading-relaxed">
        {c.pressHeroSubheadline}
      </p>
    </div>
  </section>

  <!-- Featured articles -->
  {c.featuredArticles && c.featuredArticles.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
        <h2 class="font-serif font-medium text-3xl md:text-4xl leading-tight tracking-tight text-fl-ink mb-12">
          {c.featuredArticlesHeading}
        </h2>
        <ul class="space-y-8">
          {c.featuredArticles.map((a) => (
            <li class="bg-white border border-slate-200 p-8 md:p-10">
              <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-3">
                {a.publication}{a.date ? ` · ${a.date}` : ''}
              </p>
              <h3 class="font-serif text-2xl md:text-3xl text-fl-ink mb-5 leading-snug">
                {a.headline}
              </h3>
              <p class="text-fl-ink-soft leading-relaxed">{a.summary}</p>
              {a.pullQuote && (
                <blockquote class="mt-6 border-l-2 border-fl-accent pl-6 font-serif italic text-lg text-fl-ink leading-snug">
                  &ldquo;{a.pullQuote}&rdquo;
                </blockquote>
              )}
              {a.pullQuotes && a.pullQuotes.length > 0 && (
                <div class="mt-6 space-y-5">
                  {a.pullQuotes.map((q) => (
                    <blockquote class="border-l-2 border-fl-accent pl-6 font-serif italic text-lg text-fl-ink leading-snug">
                      &ldquo;{q}&rdquo;
                    </blockquote>
                  ))}
                </div>
              )}
              {a.href && (
                <a
                  href={a.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block mt-6 text-fl-accent font-medium hover:text-fl-accent-2 transition-colors text-sm"
                >
                  Read article &rarr;
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Speaking & Events -->
  {c.pressSpeaking && c.pressSpeaking.length > 0 && (
    <section class="mx-auto max-w-5xl px-6 py-20 md:py-24">
      <h2 class="font-serif font-medium text-3xl md:text-4xl leading-tight tracking-tight text-fl-ink mb-12">
        {c.pressSpeakingHeading}
      </h2>
      <ul class="space-y-10">
        {c.pressSpeaking.map((s) => (
          <li>
            <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-3">
              {s.date}
            </p>
            <h3 class="font-serif text-2xl text-fl-ink mb-2 leading-snug">
              {s.event}
            </h3>
            {s.session && (
              <p class="font-serif italic text-lg text-fl-ink-soft mb-2 leading-snug">
                {s.session}
              </p>
            )}
            {s.location && (
              <p class="text-sm text-fl-ink-soft mb-5">{s.location}</p>
            )}
            <p class="text-fl-ink-soft leading-relaxed max-w-3xl">{s.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <!-- Media inquiries -->
  {c.pressInquiriesHeading && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <h2 class="font-serif font-medium text-3xl md:text-4xl leading-tight tracking-tight mb-8">
          {c.pressInquiriesHeading}
        </h2>
        <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-8">
          {c.pressInquiriesBody}
        </p>
        {h.feeNote && (
          <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
            {h.feeNote}
          </p>
        )}
        <div class="flex flex-wrap items-center justify-center gap-6">
          <a
            href={c.pressInquiriesCTAHref}
            class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
          >
            {c.pressInquiriesCTAText}
          </a>
          {c.pressInquiriesEmail && (
            <span class="text-white/80 text-sm">
              or email
              <a href={`mailto:${c.pressInquiriesEmail}`} class="text-white font-medium hover:underline">
                {c.pressInquiriesEmail}
              </a>
            </span>
          )}
        </div>
      </div>
    </section>
  )}
</Layout>
