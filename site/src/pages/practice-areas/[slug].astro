---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const areas = await getCollection('practiceAreas');
  return areas.map((area) => ({
    params: { slug: area.id },
    props: { area },
  }));
}

const { area } = Astro.props;
const { Content } = await render(area);

const homepage = await getEntry('pages', 'homepage');
const h = homepage!.data;

const seoTitle = area.data.seoTitle ?? `${area.data.name} — Fingerhut Law`;
const seoDescription = area.data.seoDescription ?? area.data.intakeSummary;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://fingerhutlawgroup.com/' },
    { '@type': 'ListItem', position: 2, name: 'Practice Areas', item: 'https://fingerhutlawgroup.com/practice-areas' },
    { '@type': 'ListItem', position: 3, name: area.data.name, item: `https://fingerhutlawgroup.com/practice-areas/${area.id}` },
  ],
};
---

<Layout title={seoTitle} description={seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Hero -->
  <section class="mx-auto max-w-5xl px-6 pt-24 pb-12">
    <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
      <a href="/practice-areas" class="hover:underline">Practice Areas</a>
      <span class="text-fl-ink-soft"> &nbsp;/&nbsp; </span>
    </p>
    <h1 class="font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight max-w-4xl">
      {area.data.name}
    </h1>
    <p class="mt-6 text-2xl text-fl-accent font-serif italic max-w-3xl leading-snug">
      {area.data.tagline}
    </p>
  </section>

  <!-- Case callout if present -->
  {area.data.caseCallout && (
    <section class="mx-auto max-w-5xl px-6 pb-12">
      <div class="border-l-4 border-fl-accent pl-6 py-2">
        <p class="font-serif text-3xl md:text-4xl font-medium text-fl-accent tracking-tight mb-1">
          {area.data.caseCallout.figure}
        </p>
        <p class="text-fl-ink-soft leading-relaxed">{area.data.caseCallout.description}</p>
      </div>
    </section>
  )}

  <!-- Body — Vincent's SEO article goes here (renders the .md body) -->
  <section class="mx-auto max-w-3xl px-6 pb-20">
    <article class="prose-fl prose-fl-page">
      <Content />
    </article>
  </section>

  <!-- Statutes sidebar -->
  {area.data.statutes && area.data.statutes.length > 0 && (
    <section class="bg-slate-50 border-y border-slate-200">
      <div class="mx-auto max-w-3xl px-6 py-16">
        <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
          Relevant Statutes
        </p>
        <ul class="space-y-2">
          {area.data.statutes.map((s) => (
            <li class="text-fl-ink-soft leading-relaxed">
              <span class="text-fl-accent mr-2">·</span>{s}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-fl-accent text-white">
    <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
      <h2 class="font-serif font-medium text-3xl md:text-4xl leading-tight tracking-tight mb-8">
        If your rights at work have been violated, do not wait.
      </h2>
      <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-6">
        Employment claims in New York have short deadlines — sometimes as short as 180 days.
        Contact Fingerhut Law for a free, confidential consultation.
      </p>
      <p class="text-sm text-white/80 italic max-w-2xl mx-auto mb-4">
        Free, confidential consultation — no obligation.
      </p>
      {h.feeNote && (
        <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
          {h.feeNote}
        </p>
      )}
      <a
        href="/contact"
        class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
      >
        Schedule a Consultation
      </a>
    </div>
  </section>
</Layout>
