---
import Layout from '../layouts/Layout.astro';
import { getEntry } from 'astro:content';

const page = await getEntry('pages', 'faq');
const c = page!.data;
const homepage = await getEntry('pages', 'homepage');
const h = homepage!.data;

// FAQPage JSON-LD for rich results — flatten every question across every
// category into the top-level mainEntity array Google expects.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: (c.faqCategories ?? []).flatMap((cat) =>
    cat.items.map((it) => ({
      '@type': 'Question',
      name: it.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: it.a,
      },
    })),
  ),
};
---

<Layout title={c.title} description={c.description}>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <style is:global>
    /* Hide native disclosure marker across browsers so the + icon owns the affordance */
    details.fl-faq-item > summary::-webkit-details-marker { display: none; }
    details.fl-faq-item > summary { list-style: none; }
  </style>

  <!-- Hero -->
  <section class="bg-slate-50 border-b border-slate-200">
    <div class="mx-auto max-w-5xl px-6 py-20 md:py-24">
      <p class="text-xs uppercase tracking-widest text-fl-accent font-semibold mb-6">
        {c.faqHeroLabel}
      </p>
      <h1 class="font-serif font-medium text-5xl md:text-6xl leading-[1.1] tracking-tight text-fl-ink max-w-4xl">
        {c.faqHeroHeadline}
      </h1>
      {c.faqHeroSubheadline && (
        <p class="mt-6 text-xl text-fl-ink-soft leading-relaxed max-w-3xl">
          {c.faqHeroSubheadline}
        </p>
      )}
    </div>
  </section>

  <!-- Intro + expand-all control -->
  <section class="mx-auto max-w-3xl px-6 pt-16 md:pt-20 pb-4">
    {c.faqIntro && (
      <p class="text-lg text-fl-ink-soft leading-relaxed">
        {c.faqIntro}
      </p>
    )}
    <div class="mt-8">
      <button
        id="fl-faq-toggle-all"
        type="button"
        data-open="false"
        class="text-sm font-semibold text-fl-accent border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
      >
        Expand all
      </button>
    </div>
  </section>

  <!-- Category sections — alternate white / slate-50 for visual rhythm -->
  <div id="faq-categories">
    {c.faqCategories && c.faqCategories.map((cat, idx) => (
      <section class={idx % 2 === 1 ? 'bg-slate-50 border-y border-slate-200' : ''}>
        <div class="mx-auto max-w-3xl px-6 py-16 md:py-20">
          <h2 class="font-serif font-medium text-3xl md:text-4xl leading-tight tracking-tight text-fl-ink mb-4">
            {cat.title}
          </h2>
          {cat.description && (
            <p class="text-fl-ink-soft italic mb-8">{cat.description}</p>
          )}
          <ul class="space-y-4 mt-8">
            {cat.items.map((it) => (
              <li class="border-b border-slate-200">
                <details class="group fl-faq-item">
                  <summary class="cursor-pointer py-5 flex items-start justify-between gap-6">
                    <span class="font-serif text-lg md:text-xl font-medium text-fl-ink leading-snug group-hover:text-fl-accent transition-colors">
                      {it.q}
                    </span>
                    <span
                      class="mt-1 shrink-0 text-fl-accent transition-transform duration-200 group-open:rotate-45 text-2xl leading-none font-light"
                      aria-hidden="true"
                    >+</span>
                  </summary>
                  <div class="pb-6 pr-10 text-fl-ink-soft leading-relaxed">
                    <p>{it.a}</p>
                    {it.linkText && it.linkHref && (
                      <p class="mt-4">
                        <a
                          href={it.linkHref}
                          class="text-fl-accent font-medium border-b-2 border-fl-accent pb-1 hover:text-fl-accent-2 hover:border-fl-accent-2 transition-colors"
                        >
                          {it.linkText} &rarr;
                        </a>
                      </p>
                    )}
                  </div>
                </details>
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))}
  </div>

  <!-- Disclaimer -->
  {c.faqDisclaimer && (
    <section class="mx-auto max-w-3xl px-6 py-16">
      <p class="text-sm text-fl-ink-soft italic border-l-2 border-fl-accent pl-4">
        {c.faqDisclaimer}
      </p>
    </section>
  )}

  <!-- Final CTA -->
  {c.faqCTAHeading && (
    <section class="bg-fl-accent text-white">
      <div class="mx-auto max-w-4xl px-6 py-24 md:py-32 text-center">
        <h2 class="font-serif font-medium text-4xl md:text-5xl leading-tight tracking-tight mb-8">
          {c.faqCTAHeading}
        </h2>
        <p class="text-lg text-white/80 leading-relaxed max-w-2xl mx-auto mb-8">
          {c.faqCTABody}
        </p>
        {h.feeNote && (
          <p class="text-sm text-white/70 italic max-w-2xl mx-auto mb-12">
            {h.feeNote}
          </p>
        )}
        <a
          href={c.faqCTAHref}
          class="inline-block bg-white text-fl-accent px-8 py-4 text-sm font-medium tracking-wide hover:bg-slate-100 transition-colors"
        >
          {c.faqCTAButton}
        </a>
      </div>
    </section>
  )}

  <script>
    const btn = document.getElementById('fl-faq-toggle-all');
    const items = document.querySelectorAll('.fl-faq-item');
    btn?.addEventListener('click', () => {
      const isOpen = btn.dataset.open === 'true';
      items.forEach((el) => {
        if (isOpen) {
          el.removeAttribute('open');
        } else {
          el.setAttribute('open', '');
        }
      });
      btn.dataset.open = String(!isOpen);
      btn.textContent = isOpen ? 'Expand all' : 'Collapse all';
    });
  </script>
</Layout>
